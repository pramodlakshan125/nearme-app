rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function acceptedConnection(userId) {
      let outgoingId = request.auth.uid + '_' + userId;
      let incomingId = userId + '_' + request.auth.uid;
      return signedIn() && (
        (exists(/databases/$(database)/documents/connection_requests/$(outgoingId))
          && get(/databases/$(database)/documents/connection_requests/$(outgoingId)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/connection_requests/$(incomingId))
          && get(/databases/$(database)/documents/connection_requests/$(incomingId)).data.status == 'accepted')
      );
    }

    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if owns(userId);
    }

    match /private_profiles/{userId} {
      allow read, write: if owns(userId);
    }

    match /shared_profiles/{userId} {
      allow read: if owns(userId) || acceptedConnection(userId);
      allow create, update, delete: if owns(userId);
    }

    match /users/{userId} {
      allow read, write: if owns(userId);
    }

    match /active_sessions/{userId} {
      allow read: if signedIn();
      allow create, update: if owns(userId)
        && request.resource.data.uid == userId
        && request.resource.data.isBroadcasting == true
        && get(/databases/$(database)/documents/public_profiles/$(userId)).data.isVisible == true;
      allow delete: if owns(userId);
    }

    match /connection_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.receiverId
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (
          requestId.matches('^' + request.auth.uid + '_.*$')
          || requestId.matches('^.*_' + request.auth.uid + '$')
          || resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow update: if signedIn() && (
        (
          resource.data.receiverId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'rejected']
        )
        || (
          resource.data.senderId == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.status == 'pending'
          && requestId == request.auth.uid + '_' + request.resource.data.receiverId
        )
      );

      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid);
    }
  }
}
